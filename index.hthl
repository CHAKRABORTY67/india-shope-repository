.addr-empty .ae-t{font-size:13px;font-weight:600;color:var(--t2);margin-bottom:4px}
.addr-empty .ae-s{font-size:12px}

@media (min-width: 992px){

  .page{
    max-width:1200px;
  }

  .bottom-nav-inner{
    max-width:1200px;
  }

}

@media (min-width: 992px){

  .page{
    width:100%;
    max-width:none;
    margin:0;
    box-shadow:none;
    border:none;
  }

  .bottom-nav-inner{
    width:100%;
    max-width:none;
  }

  .prod-grid{
    grid-template-columns:repeat(4,1fr);
  }

}

@media(min-width:481px){.page{box-shadow:0 0 40px rgba(0,0,0,.15);border-left:1px solid var(--border);border-right:1px solid var(--border)}}
